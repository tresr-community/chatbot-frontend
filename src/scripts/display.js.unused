document.addEventListener("DOMContentLoaded", function () {
  // Get the current information.
  const toggleButton = document.getElementById("modeToggle");
  const currentTheme = localStorage.getItem("theme");

  function initializeTheme() {
    if (currentTheme === "dark") {
      applyDarkMode();
    } else {
      applyLightMode();
    }
  }

  // Function to enable dark mode.
  function applyDarkMode() {
    document.documentElement.classList.add("dark");
    toggleButton.innerHTML = "🌞";
    toggleButton.classList.remove("bg-primary");
    toggleButton.classList.add("bg-dark-primary");
  }

  // Function to enable light mode.
  function applyLightMode() {
    document.documentElement.classList.remove("dark");
    toggleButton.innerHTML = "🌜";
    toggleButton.classList.remove("bg-dark-primary");
    toggleButton.classList.add("bg-primary");
  }

  // Initialize the correct theme and button state.
  initializeTheme();

  toggleButton.addEventListener("click", function () {
    const isDarkMode = document.documentElement.classList.contains("dark");
    const newTheme = isDarkMode ? "light" : "dark";

    if (isDarkMode) {
      applyLightMode();
    } else {
      applyDarkMode();
    }
    localStorage.setItem("theme", newTheme);
  });
});
