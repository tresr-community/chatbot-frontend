---
// Layouts
import Layout from "../layouts/Layout.astro";

// ChatBot Configuration
const chatbotType = "fullscreen";
const chatbotStyle = "light";
const chatbotShowButton = false;
const enableLoadingSpinner = false;
const enableQuotes = false;

// Config
import {
  title,
  footerMessage,
  welcomeMessage,
  chatbotApiVersion,
  chatbotApiBackend,
} from "../config";
---

<Layout
  title={title}
  footerMessage={footerMessage}
  welcomeMessage={welcomeMessage}
  chatbotType={chatbotType}
  chatbotStyle={chatbotStyle}
  chatbotApiVersion={chatbotApiVersion}
  chatbotApiBackend={chatbotApiBackend}
  chatbotShowButton={chatbotShowButton}
  enableLoadingSpinner={enableLoadingSpinner}
  enableQuotes={enableQuotes}
/>
