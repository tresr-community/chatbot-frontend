---
import "../styles/global.css";
---

<style is:global>
  :root {
    --accent: 124, 58, 237;
    --accent-light: 236, 232, 255;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-family: sans-serif;
    background-color: rgb(var(--accent-light));
    color: rgb(var(--accent));
  }
</style>
