---
interface Props {
  welcomeMessage: string;
  enableQuotes: boolean;
  enableLoadingSpinner: boolean;
  chatbotShowButton: boolean;
}

const {
  welcomeMessage = "Welcome Message goes here",
  enableQuotes = true,
  enableLoadingSpinner = true,
  chatbotShowButton = true,
} = Astro.props;
---

<div class="bg-container">
  <div class="content">
    <!-- Dark Mode Toggle Button -->
    <button id="modeToggle" type="button" class="theme-switcher-button">
      🌜
    </button>

    <!-- Ron Jay Image & Speech Bubble Quotes if enabled-->
    {
      enableQuotes && (
        <div class="container-ron-jay">
          <img src="/images/NFTREASURE.png" alt="NFTREASURE" class="logo" />
          <img src="/images/ron_jay.png" alt="Ron Jay" class="image-ron-jay" />
          <div id="speech-bubble" class="speech-bubble">
            <div id="quoteText">{welcomeMessage}</div>
          </div>
        </div>
      )
    }

    <!-- Loading Spinner if enabled -->
    {
      enableLoadingSpinner && (
        <div id="chatbot-loading-spinner" class="chatbotUI-loader" />
      )
    }

    <!-- The Chatbot Toggle Button if enabled -->
    {
      chatbotShowButton && (
        <div id="chatbot-show-button-container">
          <button
            id="chatbot-toggle"
            type="button"
            class="chatbotUI-toggle-button show"
          >
            💬
          </button>
          <div id="chatbot-container" class="chatbotUI-container hide" />
        </div>
      )
    } else {(<div id="chatbot-container" class="chatbotUI-container show" />)}
  </div>
  <!-- content -->
</div>
<!-- bg-container -->
