---
// Props
interface Props {
  type: "widget" | "fullscreen";
  style: "light" | "dark";
  apiVersion: "v1" | "v2";
  apiBackend: "grok" | "chatbot" | "google-ai-studio";
  showButton: boolean;
  enableLoadingSpinner: boolean;
}

const {
  type,
  style,
  apiVersion,
  apiBackend,
  showButton,
  enableLoadingSpinner,
} = Astro.props;
---

<script
  src="/js/chatbot.js"
  data-chatbot-type={type}
  data-chatbot-style={style}
  data-chatbot-api-version={apiVersion}
  data-chatbot-api-backend={apiBackend}
  data-chatbot-show-button={showButton}
  data-chatbot-enable-loading-spinner={enableLoadingSpinner}
  defer></script>
